# Paddle client-side token (Dashboard → Developer tools → Authentication)
# Sandbox: test_...  |  Live: live_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx

# sandbox | production
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Shared activity log (server-side fetch — not exposed to browser)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional — app download links in share page footer (when live)
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id...
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...

# Set to true when the app is on the stores — download CTAs link out instead of the waitlist modal
# 